-- Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

-- Variables
local player = Players.LocalPlayer
local gui = nil
local hubFrame = nil
local isOpen = true
local autoBuyEnabled = false
local running = false
local remoteThread = nil

-- Remote setup
local remoteFolder = ReplicatedStorage:WaitForChild("BridgeNet2")
local remote = remoteFolder:WaitForChild("dataRemoteEvent")

-- Data
local allGears = {
    "Water Bucket",
    "Frost Grenade",
    "Cocotank",
}

local allSeeds = {
    "Sunflower Seed",
    "Dragon Fruit Seed",
    "Water Bucket",
    "Frost Grenade",
    "Cocotank",
    "Watermelon",
    "Eggplant",
    "Carnivorous Plant Seed",
    "Mr Carrot Seed",
    "Tomatrio Seed",
}

-- Auto Buy Functions
local function autoBuyAllGears()
    if not autoBuyEnabled then return end
    
    for _, gear in ipairs(allGears) do
        local args = {
            { gear, " " }
        }
        remote:FireServer(unpack(args))
        task.wait(0.05)
    end
end

local function autoRemoteLoop()
    while running and autoBuyEnabled do
        local args1 = {
            { [2] = "5" }
        }
        remote:FireServer(unpack(args1))
        
        for _, seed in ipairs(allSeeds) do
            local args2 = {
                { seed, "\a" }
            }
            remote:FireServer(unpack(args2))
            task.wait(0.05)
        end
        
        autoBuyAllGears()
        task.wait(0.3)
    end
end

-- UI Creation Functions
local function createToggleButton(parent, text, subtext, icon, initialState, callback)
    local btnFrame = Instance.new("Frame")
    btnFrame.Size = UDim2.new(1, -18, 0, subtext and 50 or 40)
    btnFrame.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    btnFrame.BorderSizePixel = 0
    btnFrame.Parent = parent
    
    local btnCorner = Instance.new("UICorner", btnFrame)
    btnCorner.CornerRadius = UDim.new(0, 10)
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = btnFrame
    
    local btnTitle = Instance.new("TextLabel")
    btnTitle.Size = UDim2.new(1, -80, 0, 16)
    btnTitle.Position = UDim2.new(0, 12, 0, 7)
    btnTitle.BackgroundTransparency = 1
    btnTitle.Text = text
    btnTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    btnTitle.Font = Enum.Font.GothamBold
    btnTitle.TextSize = 13
    btnTitle.TextXAlignment = Enum.TextXAlignment.Left
    btnTitle.Parent = btnFrame
    
    if subtext then
        local btnSub = Instance.new("TextLabel")
        btnSub.Size = UDim2.new(1, -80, 0, 12)
        btnSub.Position = UDim2.new(0, 12, 0, 25)
        btnSub.BackgroundTransparency = 1
        btnSub.Text = subtext
        btnSub.TextColor3 = Color3.fromRGB(180, 180, 180)
        btnSub.Font = Enum.Font.Gotham
        btnSub.TextSize = 10
        btnSub.TextXAlignment = Enum.TextXAlignment.Left
        btnSub.Parent = btnFrame
    end
    
    -- Toggle switch
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Size = UDim2.new(0, 40, 0, 20)
    toggleFrame.Position = UDim2.new(1, -50, 0, 10)
    toggleFrame.BackgroundColor3 = initialState and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(100, 100, 100)
    toggleFrame.BorderSizePixel = 0
    toggleFrame.Parent = btnFrame
    
    local toggleCorner = Instance.new("UICorner", toggleFrame)
    toggleCorner.CornerRadius = UDim.new(0, 10)
    
    local toggleButton = Instance.new("Frame")
    toggleButton.Size = UDim2.new(0, 16, 0, 16)
    toggleButton.Position = initialState and UDim2.new(0, 22, 0, 2) or UDim2.new(0, 2, 0, 2)
    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.BorderSizePixel = 0
    toggleButton.Parent = toggleFrame
    
    local toggleBtnCorner = Instance.new("UICorner", toggleButton)
    toggleBtnCorner.CornerRadius = UDim.new(0, 8)
    
    local state = initialState
    
    btn.MouseButton1Click:Connect(function()
        state = not state
        
        local colorTween = TweenService:Create(
            toggleFrame,
            TweenInfo.new(0.2, Enum.EasingStyle.Quad),
            {BackgroundColor3 = state and Color3.fromRGB(0, 170, 0) or Color3.fromRGB(100, 100, 100)}
        )
        
        local positionTween = TweenService:Create(
            toggleButton,
            TweenInfo.new(0.2, Enum.EasingStyle.Quad),
            {Position = state and UDim2.new(0, 22, 0, 2) or UDim2.new(0, 2, 0, 2)}
        )
        
        colorTween:Play()
        positionTween:Play()
        
        if callback then
            callback(state)
        end
    end)
    
    return btnFrame
end


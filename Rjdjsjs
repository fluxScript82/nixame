-- Toggle GUI Function
local function toggleGUI()
    if not hubFrame then return end
    
    isOpen = not isOpen
    
    local targetPosition = isOpen and UDim2.new(0.5, 0, 0.5, 0) or UDim2.new(0.5, 0, -0.5, 0)
    
    local tween = TweenService:Create(
        hubFrame,
        TweenInfo.new(0.3, Enum.EasingStyle.Back),
        {Position = targetPosition}
    )
    
    tween:Play()
end

-- Create GUI Function
local function createGUI()
    -- Main ScreenGui
    gui = Instance.new("ScreenGui")
    gui.Name = "FtgsHub"
    gui.Parent = player:WaitForChild("PlayerGui")
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    
    -- Main Hub Frame
    hubFrame = Instance.new("Frame")
    hubFrame.Size = UDim2.new(0, 420, 0, 350)
    hubFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    hubFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    hubFrame.BorderSizePixel = 0
    hubFrame.Parent = gui
    hubFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    
    local hubCorner = Instance.new("UICorner", hubFrame)
    hubCorner.CornerRadius = UDim.new(0, 12)
    
    -- Top bar
    local topBar = Instance.new("Frame")
    topBar.Size = UDim2.new(1, 0, 0, 30)
    topBar.BackgroundTransparency = 1
    topBar.Parent = hubFrame
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(0, 150, 0, 30)
    title.Position = UDim2.new(0, 16, 0, 0)
    title.BackgroundTransparency = 1
    title.Text = ".ftgs hub"
    title.TextColor3 = Color3.fromRGB(220, 220, 220)
    title.Font = Enum.Font.GothamBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextYAlignment = Enum.TextYAlignment.Center
    title.TextSize = 16
    title.Parent = topBar
    
    -- Close button
    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0, 30, 0, 30)
    closeButton.Position = UDim2.new(1, -35, 0, 0)
    closeButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    closeButton.Text = "×"
    closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeButton.Font = Enum.Font.GothamBold
    closeButton.TextSize = 18
    closeButton.AutoButtonColor = false
    closeButton.Parent = topBar
    
    local closeCorner = Instance.new("UICorner", closeButton)
    closeCorner.CornerRadius = UDim.new(0, 8)
    
    closeButton.MouseButton1Click:Connect(toggleGUI)
    
    -- Main Content Frame
    local mainFrame = Instance.new("Frame")
    mainFrame.Size = UDim2.new(1, -20, 1, -50)
    mainFrame.Position = UDim2.new(0, 10, 0, 40)
    mainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    mainFrame.BorderSizePixel = 0
    mainFrame.Parent = hubFrame
    
    local mainCorner = Instance.new("UICorner", mainFrame)
    mainCorner.CornerRadius = UDim.new(0, 10)
    
    local mainList = Instance.new("UIListLayout", mainFrame)
    mainList.Padding = UDim.new(0, 8)
    mainList.SortOrder = Enum.SortOrder.LayoutOrder
    
    local padding = Instance.new("UIPadding", mainFrame)
    padding.PaddingTop = UDim.new(0, 10)
    padding.PaddingLeft = UDim.new(0, 10)
    padding.PaddingRight = UDim.new(0, 10)
    padding.PaddingBottom = UDim.new(0, 10)
    
    -- Auto Buy Toggle
    createToggleButton(mainFrame, "Auto Buy", "Toggle automatic buying on/off", "🛒", autoBuyEnabled, function(state)
        autoBuyEnabled = state
        if not state and running then
            running = false
            if remoteThread then
                task.cancel(remoteThread)
                remoteThread = nil
            end
        end
        print("Auto Buy:", state and "ON" or "OFF")
    end)
    
    -- Manual Buy Gears Button
    createButtonEntry(mainFrame, "Buy All Gears", "Manually buy all gears once", "⚙️", false, function()
        if autoBuyEnabled then
            autoBuyAllGears()
        else
            print("Auto Buy is disabled!")
        end
    end)
    
    -- Auto Remote Loop Toggle
    createToggleButton(mainFrame, "Auto Remote Loop", "Toggle automatic remote loop", "🔄", running, function(state)
        if not autoBuyEnabled then
            print("Enable Auto Buy first!")
            return
        end
        
        running = state
        if running then
            remoteThread = task.spawn(autoRemoteLoop)
            print("Auto Remote Loop: ON")
        else
            if remoteThread then
                task.cancel(remoteThread)
                remoteThread = nil
            end
            print("Auto Remote Loop: OFF")
        end
    end)
    
    -- Locked Features
    createButtonEntry(mainFrame, "Premium Feature", "Unlock with premium", "✨", true)
    createButtonEntry(mainFrame, "Advanced Settings", "Coming soon", "⚙️", true)
    
    -- Dragging functionality
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = hubFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            hubFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

-- Keybind to toggle GUI (Insert key)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.Insert then
        if not gui then
            createGUI()
        else
            toggleGUI()
        end
    end
end)

-- Initialize GUI
createGUI()

print("Ftgs Hub loaded! Press INSERT to toggle GUI")

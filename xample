    colorBar.BackgroundColor3 = typeColors[notificationConfig.Type] or theme.Info
    colorBar.BorderSizePixel = 0
    colorBar.Parent = notificationFrame
    
    local colorCorner = Instance.new("UICorner")
    colorCorner.CornerRadius = UDim.new(0, 2)

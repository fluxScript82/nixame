        CreateTween(miniFrame, {Size = UDim2.new(0, 110, 0, 35)}, 0.1):Play()
        wait(0.1)
        CreateTween(miniFrame, {Size = UDim2.new(0, 120, 0, 40)}, 0.1):Play()
        
        miniConfig.OnToggle()
    end)
    
    -- Entrance animation
    miniFrame.Position = UDim2.new(miniConfig.Position.X.Scale, miniConfig.Position.X.Offset - 150, miniConfig.Position.Y.Scale, miniConfig.Position.Y.Offset)
    CreateSpring(miniFrame, {Position = miniConfig.Position}, 0.6):Play()
    
    return {
        Frame = miniFrame,
        Destroy = function()
            screenGui:Destroy()
        end,
        SetVisible = function(visible)
            screenGui.Enabled = visible
        end
    }
end


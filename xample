    local icons = {
        Info = "ℹ",
        Success = "✓",
        Warning = "⚠",
        Error = "✗"
    }
    icon.Text = icons[notificationConfig.Type] or "ℹ"
    
    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -60, 0, 20)
    title.Position = UDim2.new(0, 50, 0, 10)
    title.BackgroundTransparency = 1
    title.Text = notificationConfig.Title
    title.TextColor3 = theme.Text
    title.TextSize = 14
    title.Font = Enum.Font.SourceSansBold
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = notificationFrame
    
    -- Description
    local description = Instance.new("TextLabel")
    description.Size = UDim2.new(1, -60, 0, 40)
    description.Position = UDim2.new(0, 50, 0, 30)
    description.BackgroundTransparency = 1
    description.Text = notificationConfig.Description
    description.TextColor3 = theme.TextSecondary
    description.TextSize = 12
    description.Font = Enum.Font.SourceSans
    description.TextXAlignment = Enum.TextXAlignment.Left
    description.TextWrapped = true
    description.Parent = notificationFrame
    
    -- Close button
    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0, 20, 0, 20)
    closeButton.Position = UDim2.new(1, -25, 0, 5)
    closeButton.BackgroundTransparency = 1
    closeButton.Text = "×"
    closeButton.TextColor3 = theme.TextSecondary
    closeButton.TextSize = 16
    closeButton.Font = Enum.Font.SourceSansBold
    closeButton.Parent = notificationFrame
    
    -- Progress bar
    local progressBar = Instance.new("Frame")
    progressBar.Size = UDim2.new(1, 0, 0, 2)
    progressBar.Position = UDim2.new(0, 0, 1, -2)
    progressBar.BackgroundColor3 = typeColors[notificationConfig.Type] or theme.Info
    progressBar.BorderSizePixel = 0
    progressBar.Parent = notificationFrame
    
    -- Animations
    notificationFrame.Position = UDim2.new(
        positions[notificationConfig.Position].X.Scale,
        positions[notificationConfig.Position].X.Offset + 320,
        positions[notificationConfig.Position].Y.Scale,
        positions[notificationConfig.Position].Y.Offset
    )
    
    CreateSpring(notificationFrame, {Position = positions[notificationConfig.Position]}, 0.5):Play()
    
    -- Progress animation
    CreateTween(progressBar, {Size = UDim2.new(0, 0, 0, 2)}, notificationConfig.Duration):Play()
    
    -- Auto close
    local notification = {
        Frame = notificationFrame,
        ScreenGui = screenGui
    }
    
    table.insert(self.Notifications, notification)
    
    local function closeNotification()
        CreateTween(notificationFrame, {
            Position = UDim2.new(
                positions[notificationConfig.Position].X.Scale,
                positions[notificationConfig.Position].X.Offset + 320,
                positions[notificationConfig.Position].Y.Scale,
                positions[notificationConfig.Position].Y.Offset
            )
        }, 0.3):Play()
        
        wait(0.3)
        screenGui:Destroy()
        
        -- Remove from notifications table
        for i, notif in ipairs(self.Notifications) do
            if notif == notification then
                table.remove(self.Notifications, i)
                break
            end
        end
    end
    
    closeButton.MouseButton1Click:Connect(closeNotification)
    
    spawn(function()
        wait(notificationConfig.Duration)
        closeNotification()
    end)
    
    PlaySound(Sounds.Notification, 0.4)
    
    return notification
end


                    sliderButton.Position = UDim2.new((currentValue - sliderConfig.Min) / (sliderConfig.Max - sliderConfig.Min), -10, 0.5, -10)
                    sliderFill.Size = UDim2.new((currentValue - sliderConfig.Min) / (sliderConfig.Max - sliderConfig.Min), 0, 1, 0)
                    
                    sliderConfig.Callback(currentValue)
                end
            end)
            
            table.insert(self.Elements, sliderFrame)
            return {
                Frame = sliderFrame,
                SetValue = function(value)
                    currentValue = math.clamp(value, sliderConfig.Min, sliderConfig.Max)
                    local relativePos = (currentValue - sliderConfig.Min) / (sliderConfig.Max - sliderConfig.Min)
                    valueLabel.Text = tostring(currentValue)
                    sliderButton.Position = UDim2.new(relativePos, -10, 0.5, -10)
                    sliderFill.Size = UDim2.new(relativePos, 0, 1, 0)
                end,
                GetValue = function()
                    return currentValue
                end
            }
        end
        

            keybind.Callback()
            PlaySound(Sounds.Click, 0.3)
        end
    end
end)

-- Config System
function ProfessionalUI:SaveConfig(name, data)
    name = name or "default"
    self.Config[name] = data
    
    if writefile then
        local success, err = pcall(function()
            writefile("ProfessionalUI_" .. name .. ".json", HttpService:JSONEncode(data))
        end)
        if success then
            self:CreateNotification({
                Title = "Config Saved",
                Description = "Configuration saved successfully!",
                Type = "Success"
            })
        end
    end
end

function ProfessionalUI:LoadConfig(name)
    name = name or "default"
    
    if readfile and isfile and isfile("ProfessionalUI_" .. name .. ".json") then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile("ProfessionalUI_" .. name .. ".json"))
        end)
        if success then
            self.Config[name] = data
            self:CreateNotification({
                Title = "Config Loaded",
                Description = "Configuration loaded successfully!",
                Type = "Success"
            })
            return data
        end
    end
    
    return nil
end


        Title = config.Title or "Notification",
        Description = config.Description or "This is a notification",
        Type = config.Type or "Info", -- Info, Success, Warning, Error
        Duration = config.Duration or 5,
        Position = config.Position or "TopRight" -- TopRight, TopLeft, BottomRight, BottomLeft
    }
    
    local theme = Themes.Dark -- Use dark theme for notifications
    local typeColors = {
        Info = theme.Info,
        Success = theme.Success,
        Warning = theme.Warning,
        Error = theme.Error
    }
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "Notification_" .. HttpService:GenerateGUID(false)
    screenGui.Parent = GuiParent
    
    local notificationFrame = Instance.new("Frame")
    notificationFrame.Size = UDim2.new(0, 300, 0, 80)
    notificationFrame.BackgroundColor3 = theme.Background
    notificationFrame.BorderSizePixel = 0
    notificationFrame.Parent = screenGui
    
    -- Position based on config
    local positions = {
        TopRight = UDim2.new(1, -320, 0, 20 + #self.Notifications * 90),
        TopLeft = UDim2.new(0, 20, 0, 20 + #self.Notifications * 90),
        BottomRight = UDim2.new(1, -320, 1, -100 - #self.Notifications * 90),
        BottomLeft = UDim2.new(0, 20, 1, -100 - #self.Notifications * 90)
    }
    
    notificationFrame.Position = positions[notificationConfig.Position] or positions.TopRight
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = notificationFrame
    

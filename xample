            progressTrack.BackgroundColor3 = Window.Theme.Accent
            progressTrack.BorderSizePixel = 0
            progressTrack.Parent = progressFrame
            
            local trackCorner = Instance.new("UICorner")
            trackCorner.CornerRadius = UDim.new(0, 4)
            trackCorner.Parent = progressTrack
            
            local progressFill = Instance.new("Frame")
            progressFill.Size = UDim2.new((progressConfig.Default - progressConfig.Min) / (progressConfig.Max - progressConfig.Min), 0, 1, 0)
            progressFill.BackgroundColor3 = Window.Theme.Success
            progressFill.BorderSizePixel = 0
            progressFill.Parent = progressTrack
            
            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(0, 4)
            fillCorner.Parent = progressFill
            
            CreateGradient(progressFill, {
                ColorSequenceKeypoint.new(0, Window.Theme.Success),
                ColorSequenceKeypoint.new(1, Color3.new(
                    Window.Theme.Success.R * 1.2,
                    Window.Theme.Success.G * 1.2,
                    Window.Theme.Success.B * 1.2
                ))
            }, 90)
            
            local currentValue = progressConfig.Default
            
            table.insert(self.Elements, progressFrame)
            return {
                Frame = progressFrame,
                SetValue = function(value)
                    currentValue = math.clamp(value, progressConfig.Min, progressConfig.Max)
                    local percentage = (currentValue - progressConfig.Min) / (progressConfig.Max - progressConfig.Min)
                    percentLabel.Text = math.floor(percentage * 100) .. "%"
                    CreateTween(progressFill, {Size = UDim2.new(percentage, 0, 1, 0)}, 0.3):Play()
                end,
                GetValue = function()
                    return currentValue
                end
            }
        end
        
        function tab:CreateLabel(config)
            config = config or {}
            local labelConfig = {
                Text = config.Text or "Label",
                Size = config.Size or 14,
                Color = config.Color or nil
            }
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 0, 25)
            label.BackgroundTransparency = 1
            label.Text = labelConfig.Text
            label.TextColor3 = labelConfig.Color or Window.Theme.Text
            label.TextSize = labelConfig.Size
            label.Font = Enum.Font.SourceSans
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = self.Frame
            
            table.insert(self.Elements, label)
            return {
                Label = label,
                SetText = function(text)
                    label.Text = text
                end,
                SetColor = function(color)
                    label.TextColor3 = color
                end
            }
        end
        
        function tab:CreateSeparator(config)
            config = config or {}
            local separatorConfig = {
                Text = config.Text or nil
            }
            
            local separatorFrame = Instance.new("Frame")
            separatorFrame.Size = UDim2.new(1, 0, 0, separatorConfig.Text and 30 or 15)
            separatorFrame.BackgroundTransparency = 1
            separatorFrame.Parent = self.Frame
            
            local line = Instance.new("Frame")
            line.Size = UDim2.new(1, -20, 0, 1)
            line.Position = UDim2.new(0, 10, 0.5, 0)
            line.BackgroundColor3 = Window.Theme.Accent
            line.BorderSizePixel = 0
            line.Parent = separatorFrame
            
            if separatorConfig.Text then
                local separatorLabel = Instance.new("TextLabel")
                separatorLabel.Size = UDim2.new(0, 100, 0, 20)
                separatorLabel.Position = UDim2.new(0.5, -50, 0, 5)
                separatorLabel.BackgroundColor3 = Window.Theme.Background
                separatorLabel.BorderSizePixel = 0
                separatorLabel.Text = separatorConfig.Text
                separatorLabel.TextColor3 = Window.Theme.TextSecondary
                separatorLabel.TextSize = 12
                separatorLabel.Font = Enum.Font.SourceSans
                separatorLabel.Parent = separatorFrame
            end
            
            table.insert(self.Elements, separatorFrame)
            return {
                Frame = separatorFrame
            }
        end
        
        return tab
    end
    
    function Window:SelectTab(tab)
        -- Hide all tabs
        for _, t in pairs(self.Tabs) do
            t.Frame.Visible = false
            CreateTween(t.Button, {
                BackgroundColor3 = self.Theme.Accent,
                TextColor3 = self.Theme.TextSecondary
            }, 0.2):Play()
        end
        
        -- Show selected tab
        tab.Frame.Visible = true
        CreateTween(tab.Button, {
            BackgroundColor3 = self.Theme.Primary,
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }, 0.2):Play()
        self.CurrentTab = tab
    end
    
    function Window:Destroy()
        if miniUI then
            miniUI.Destroy()
        end
        screenGui:Destroy()
    end
    
    function Window:SaveConfig(name)
        if windowConfig.SaveConfig then
            local config = {}
            for _, tab in pairs(self.Tabs) do
                config[tab.Button.Text] = {}
                for _, element in pairs(tab.Elements) do
                    if element.GetValue then
                        config[tab.Button.Text][element] = element.GetValue()
                    end
                end
            end
            ProfessionalUI:SaveConfig(name or "window_config", config)
        end
    end
    
    function Window:LoadConfig(name)
        if windowConfig.SaveConfig then
            local config = ProfessionalUI:LoadConfig(name or "window_config")
            if config then
                -- Apply loaded config to elements
                -- Implementation would depend on how elements are tracked
            end
        end
    end
    
    -- Entrance animation
    mainFrame.Size = UDim2.new(0, 0, 0, 0)
    mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    mainFrame.Rotation = -20
    
    CreateSpring(mainFrame, {
        Size = UDim2.new(0, windowConfig.Size.X, 0, windowConfig.Size.Y),
        Position = UDim2.new(0.5, -windowConfig.Size.X/2, 0.5, -windowConfig.Size.Y/2),
        Rotation = 0
    }, 0.8):Play()
    
    return Window
end

return ProfessionalUI

                    Size = UDim2.new(1, 0, 0, 42),
                    BackgroundColor3 = Color3.new(
                        Window.Theme.Primary.R * 1.1,
                        Window.Theme.Primary.G * 1.1,
                        Window.Theme.Primary.B * 1.1
